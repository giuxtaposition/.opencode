{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientId": "<OPENCODE_FIGMA_CLIENT_ID>",
        "clientSecret": "<OPENCODE_FIGMA_CLIENT_SECRET>"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
